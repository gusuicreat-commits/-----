{
  "type": "object",
  "required": [
    "facts"
  ],
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "value",
          "source",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "quantitative",
              "qualitative"
            ]
          },
          "unit": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "properties": {
              "doc": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string"
              }
            }
          },
          "status": {
            "enum": [
              "verified",
              "confirmed",
              "needs_review",
              "rejected"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "qualitative"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "quantitative"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "unit"
              ],
              "properties": {
                "value": {
                  "type": "number"
                }
              }
            }
          }
        ]
      }
    }
  }
}
